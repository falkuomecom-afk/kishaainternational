{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "functions": {
        "src/**": {
          "includeFiles": "{views/**,data/**,client/dist/**,public/dist/**}"
        },
        "api/**": {
          "includeFiles": "{views/**,data/**,client/dist/**,public/dist/**}"
        }
      }
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/css/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/js/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/feed.xml",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/img/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/logo.png",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
