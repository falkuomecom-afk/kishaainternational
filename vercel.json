{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "includeFiles": [
        "views/**",
        "public/**",
        "src/schema.sql"
      ]
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "views/**"
    },
    "src/server.js": {
      "includeFiles": "views/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/css/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/js/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/feed.xml",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
