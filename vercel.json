{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "views/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/llms.txt", "destination": "/api" },
    { "source": "/feed.xml", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
